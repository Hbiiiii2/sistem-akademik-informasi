{
  "entities": {
    "mahasiswa": {
      "title": "Mahasiswa",
      "description": "Data mahasiswa",
      "type": "object",
      "properties": {
        "nama": { "type": "string", "description": "Nama lengkap mahasiswa" },
        "nim": { "type": "string", "description": "Nomor Induk Mahasiswa" },
        "jurusan": { "type": "string", "description": "Jurusan mahasiswa" },
        "semester": { "type": "integer", "description": "Semester saat ini" },
        "email": { "type": "string", "description": "Alamat email mahasiswa" },
        "nomor_hp": { "type": "string", "description": "Nomor handphone mahasiswa" },
        "status": { "type": "string", "description": "Status aktif/tidak aktif", "enum": ["Aktif", "Cuti", "Lulus", "Keluar"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["nama", "nim", "jurusan", "semester", "email"]
    },
    "dosen": {
      "title": "Dosen",
